    "interactive": false,
    "spinner": {
      "files": {
        "dark": "spinner-hex-dark",
        "cream": "spinner-hex-cream",
        "ink": "spinner-hex-ink"
      },
      "frame_art_px": [
        10,
        10
      ],
      "frames_animated": 6,
      "fps": 10,
      "loop": true,
      "pivot": "center",
      "reduced_motion_frame_index": 6,
      "display": {
        "default_scale": 3,
        "size_dp": 30,
        "use_when_button_width_dp_at_least": 54,
        "narrower_buttons_scale": 2,
        "size_dp_at_2x": 20,
        "note": "30dp = 10 art px x 3; needs 12dp text padding each side so 54dp min width; icon-only 48dp buttons use 2x (20dp)"
      },
      "sheet": "7 frames in a row: 0-5 animation, 6 = all dots lit (static fallback)"
    },
    "label": "hide the label while loading, spinner centred in the pressed clear zone"
  },
  "naming_note": "plain .png (not .9.png) so Android tooling does not treat them as nine-patch files; insets live in this JSON",
