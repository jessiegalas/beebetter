{
  "asset": "pixel-button",
  "version": "0.4.0",
  "themes_available": [
    "light",
    "dark"
  ],
  "assumptions": {
    "light_theme": "all tokens confirmed (background/cream #F8F7DE, focus #854D0D)",
    "dark_theme": "fills, outlines, labels, focus ring and page background are real BeeBetter dark tokens. DERIVED (no token, my pick): the highlight/shade lip colors, the dark accent pressed fill (#BE8B27), and the dark disabled outline/highlight/shade",
    "accent_dark": "regenerated on-token (#D29D30); no longer reuses the light PNGs",
    "quiet_family": "outlined interpretation kept for quiet and accent-quiet (not borderless). Update tokens to match, or request transparent borderless versions"
  },
  "grid": {
    "base_art_px": 16,
    "scales": [
      1,
      2,
      3
    ],
    "display_scale_default": 3,
    "scaling": "integer only, nearest-neighbor, no smoothing",
    "dp_formula": "dp = art_px * display_scale"
  },
  "slice_insets_art_px": {
    "left": 4,
    "top": 4,
    "right": 4,
    "bottom": 4
  },
  "sizes": {
    "default": {
      "height_art_px": 16,
      "height_dp": 48
    },
    "compact": {
      "height_art_px": 14,
      "height_dp": 42,
      "note": "same 16px sprite 9-sliced to 14 art px tall, drawn at 3x: corners stay 12dp, only the stretchable middle shrinks (8 -> 6 art px). No fractional scaling. Still use a 48dp hit target (hitSlop)"
    },
    "wide": "any width >= 16 art px",
    "min_art_size_px": {
      "w": 8,
      "h": 8
    },
    "touch_target_dp": {
      "w": 48,
      "h": 48
    }
  },
  "content_insets_dp_at_default_scale": {
    "unit": "dp (not art px)",
    "how_to_use": "centre the real text label inside this clear zone; pressed zone is lower, so the label sinks automatically (no separate offset)",
    "min_horizontal_text_padding_dp": 16,
    "normal": {
      "left": 12,
      "right": 12,
      "top": 6,
      "bottom": 9,
      "clear_height_at_48dp": 33
    },
    "pressed": {
      "left": 12,
      "right": 12,
      "top": 9,
      "bottom": 3,
      "clear_height_at_48dp": 36
    }
  },
  "disabled": {
